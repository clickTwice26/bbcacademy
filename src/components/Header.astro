---
import { Image } from 'astro:assets';
import emblem from '~/assets/images/brand/bbca-emblem.png';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { site } from '~/config/site';
import { localizePath, t, type Lang } from '~/i18n/utils';
import { formatPhone } from '~/lib/format';
import type { UIKey } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const nav: { key: UIKey; path: string }[] = [
  { key: 'nav.about', path: '/about/' },
  { key: 'nav.people', path: '/people/' },
  { key: 'nav.heritage', path: '/heritage/' },
  { key: 'nav.projects', path: '/projects/' },
  { key: 'nav.gallery', path: '/gallery/' },
  { key: 'nav.visit', path: '/visit/' },
];

const pathname = Astro.url.pathname;
const isCurrent = (path: string) => pathname.startsWith(localizePath(path, lang));
const brandLines = lang === 'bn' ? ['বাংলাদেশ বুদ্ধিষ্ট', 'কালচারাল একাডেমী'] : ['Bangladesh Buddhist', 'Cultural Academy'];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizePath('/', lang)}>
      <Image src={emblem} alt="" width={41} layout="fixed" loading="eager" class="brand-emblem" />
      <span class="brand-name">
        {brandLines.map((line, i) => <span>{i > 0 ? ` ${line}` : line}</span>)}
      </span>
    </a>

    <nav class="nav-desktop" aria-label={t(lang, 'nav.primary')}>
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={localizePath(item.path, lang)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                {t(lang, item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <LangSwitch lang={lang} class="lang-desktop" />
      <a class="btn btn-primary support-btn" href={localizePath('/support/', lang)}>{t(lang, 'nav.support')}</a>
      <button class="menu-btn" type="button" aria-controls="menu-sheet" aria-expanded="false" data-menu-open>
        <Icon name="list" size={26} />
        <span class="visually-hidden">{t(lang, 'nav.menu')}</span>
      </button>
    </div>
  </div>

  <dialog id="menu-sheet" class="menu-sheet" aria-label={t(lang, 'nav.menu')}>
    <div class="sheet-top">
      <LangSwitch lang={lang} />
      <button class="menu-close" type="button" data-menu-close>
        <Icon name="x" size={26} />
        <span class="visually-hidden">{t(lang, 'nav.close')}</span>
      </button>
    </div>
    <nav aria-label={t(lang, 'nav.menu')}>
      <ul role="list" class="sheet-links">
        <li><a href={localizePath('/', lang)}>{t(lang, 'nav.home')}</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={localizePath(item.path, lang)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                {t(lang, item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn-primary sheet-support" href={localizePath('/support/', lang)}>{t(lang, 'nav.support')}</a>
    <div class="sheet-contact small">
      <a href={`tel:${site.phones[0]}`}><Icon name="phone" size={18} /> {formatPhone(site.phones[0], lang)}</a>
      <a href={`mailto:${site.email}`}><Icon name="envelope-simple" size={18} /> {site.email}</a>
    </div>
  </dialog>
</header>

<script>
  const sheet = document.getElementById('menu-sheet') as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (sheet && openBtn) {
    const close = () => sheet.open && sheet.close();
    openBtn.addEventListener('click', () => {
      sheet.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    sheet.addEventListener('close', () => openBtn.setAttribute('aria-expanded', 'false'));
    sheet.querySelector('[data-menu-close]')?.addEventListener('click', close);
    sheet.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    // Clicking the backdrop (the dialog element itself) closes the menu.
    sheet.addEventListener('click', (event) => {
      if (event.target === sheet) close();
    });
    window.matchMedia('(min-width: 1180px)').addEventListener('change', (event) => {
      if (event.matches) close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(251 246 238 / 0.94);
    border-bottom: 1px solid var(--line);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--ivory);
      backdrop-filter: none;
    }
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--terracotta);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand :global(.brand-emblem) {
    width: 41px;
    height: auto;
  }
  .brand-name {
    display: grid;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.15;
    letter-spacing: -0.005em;
  }
  :lang(bn) .brand-name {
    font-size: 0.98rem;
    line-height: 1.35;
  }
  /* Very narrow phones: keep brand and menu button on one row. */
  @media (max-width: 379px) {
    .bar {
      gap: var(--space-s);
    }
    .brand {
      gap: 0.5rem;
      min-width: 0;
    }
    .brand :global(.brand-emblem) {
      width: 34px;
    }
    .brand-name,
    :lang(bn) .brand-name {
      font-size: 0.86rem;
    }
    .menu-btn {
      width: 44px;
      height: 44px;
      flex-shrink: 0;
    }
  }

  .nav-desktop {
    display: none;
    margin-inline: auto;
  }
  .nav-desktop ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }
  .nav-desktop a {
    position: relative;
    display: block;
    padding: 0.55rem 0.7rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.97rem;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--r-pill);
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .nav-desktop a:hover {
    color: var(--terracotta);
    background: var(--sand);
  }
  .nav-desktop a[aria-current='page'] {
    color: var(--terracotta);
  }
  .nav-desktop a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--saffron);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-left: auto;
  }
  .support-btn {
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    font-size: 0.97rem;
  }
  .menu-btn,
  .menu-close {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--ink);
  }
  .menu-btn:hover,
  .menu-close:hover {
    background: var(--sand);
  }

  /* Below the desktop breakpoint: brand + menu button only (language & support live in the sheet). */
  .actions :global(.lang-desktop),
  .support-btn {
    display: none;
  }
  @media (min-width: 640px) {
    .actions :global(.lang-desktop) {
      display: inline-flex;
    }
  }
  @media (min-width: 1180px) {
    .nav-desktop {
      display: block;
    }
    .support-btn {
      display: inline-flex;
    }
    .menu-btn {
      display: none;
    }
    .actions {
      margin-left: 0;
    }
  }

  /* Menu sheet */
  .menu-sheet {
    width: min(420px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: var(--space-m) var(--gutter) var(--space-xl);
    border: 0;
    background: var(--ivory);
    color: var(--ink);
    box-shadow: var(--shadow-soft);
  }
  .menu-sheet[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .menu-sheet::backdrop {
    background: rgb(43 29 22 / 0.45);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu-sheet[open] {
      animation: sheet-in 0.35s var(--ease);
    }
    @keyframes sheet-in {
      from {
        transform: translateX(40px);
        opacity: 0;
      }
    }
  }
  .sheet-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .sheet-links {
    display: grid;
    gap: 0.15rem;
    padding: 0;
    list-style: none;
  }
  .sheet-links a {
    display: block;
    padding: 0.45rem 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 560;
    color: var(--ink);
    text-decoration: none;
  }
  .sheet-links a:hover,
  .sheet-links a[aria-current='page'] {
    color: var(--terracotta);
  }
  .sheet-support {
    align-self: flex-start;
  }
  .sheet-contact {
    display: grid;
    gap: var(--space-xs);
    margin-top: auto;
  }
  .sheet-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
    text-decoration: none;
  }
</style>
