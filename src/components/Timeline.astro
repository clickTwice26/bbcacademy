---
import type { Milestone } from '~/data/timeline';
import type { Lang } from '~/i18n/utils';
import { formatDate } from '~/lib/format';

interface Props {
  items: Milestone[];
  lang: Lang;
  class?: string;
}

const { items, lang, class: className } = Astro.props;
---

<ol class:list={['timeline', className]} role="list">
  {
    items.map((item) => (
      <li class="timeline-item">
        <time datetime={item.date} class="timeline-date">
          {formatDate(item.date, lang)}
        </time>
        <p class="timeline-text">{item.text[lang]}</p>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-l);
    padding: 0 0 0 1.75rem;
    list-style: none;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 0.4rem;
    width: 2px;
    background: linear-gradient(var(--saffron), var(--sand-deep));
  }
  .timeline-item {
    position: relative;
  }
  .timeline-item::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: calc(-1.75rem + 0.4rem - 5px);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ivory);
    border: 3px solid var(--terracotta);
  }
  .timeline-date {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--terracotta);
    line-height: 1.3;
  }
  .timeline-text {
    margin-top: 0.2rem;
    color: var(--ink);
  }
</style>
