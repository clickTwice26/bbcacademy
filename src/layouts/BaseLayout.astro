---
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource/hind-siliguri/400.css';
import '@fontsource/hind-siliguri/600.css';
import '@fontsource/noto-serif-bengali/600.css';
import '~/styles/global.css';
import '~/styles/bn.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url';
import hindBengali400 from '@fontsource/hind-siliguri/files/hind-siliguri-bengali-400-normal.woff2?url';
import hindBengali600 from '@fontsource/hind-siliguri/files/hind-siliguri-bengali-600-normal.woff2?url';
import notoSerifBengali600 from '@fontsource/noto-serif-bengali/files/noto-serif-bengali-bengali-600-normal.woff2?url';
import Seo from '~/components/Seo.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { site } from '~/config/site';
import { t, type Lang } from '~/i18n/utils';

interface Props {
  lang: Lang;
  /** Page title without the site name (unless fullTitle). */
  title: string;
  description: string;
  fullTitle?: boolean;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { lang, title, description, fullTitle = false, image, noindex, jsonLd } = Astro.props;
const pageTitle = fullTitle ? title : `${title} | ${site.name[lang]}`;
// Preload the fonts that render the first screen: Latin headings everywhere, Bengali text on Bangla pages.
const preloadFonts = lang === 'bn' ? [notoSerifBengali600, hindBengali400, hindBengali600] : [frauncesLatin];
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <Seo lang={lang} title={pageTitle} description={description} image={image} noindex={noindex} jsonLd={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Fade sections in as they enter the viewport (styles in global.css; skipped under reduced motion).
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window && items.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        items.forEach((el) => observer.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
