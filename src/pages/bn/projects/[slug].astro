---
import ProjectPage from '~/views/ProjectPage.astro';
import { detailProjects, type Project } from '~/data/projects';

export function getStaticPaths() {
  return detailProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
---

<ProjectPage lang="bn" project={project} />
