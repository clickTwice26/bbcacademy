---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Prose from '~/components/Prose.astro';
import Photo from '~/components/Photo.astro';
import Icon from '~/components/Icon.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ContactBlock from '~/components/ContactBlock.astro';
import { site } from '~/config/site';
import { proposedProjects } from '~/data/projects';
import { localizePath, t, type Lang } from '~/i18n/utils';
import { digits } from '~/lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const donation = site.donation;
---

<BaseLayout lang={lang} title={t(lang, 'support.metaTitle')} description={t(lang, 'support.metaDescription')}>
  <PageHeader
    lang={lang}
    title={t(lang, 'support.title')}
    lead={t(lang, 'support.lead')}
    image="projects/salban-orphanage/children-with-books.jpg"
  >
    <div class="btn-group">
      <a class="btn btn-primary" href="#give">{t(lang, 'support.giveTitle')}</a>
    </div>
  </PageHeader>

  <section class="section-tight">
    <div class="container-narrow">
      <Prose id="support-intro" lang={lang} class="support-intro" />
    </div>
  </section>

  <section class="section band-sand" aria-labelledby="ways">
    <div class="container">
      <h2 id="ways" class="ways-title">{t(lang, 'support.waysTitle')}</h2>

      <div class="way way-children">
        <Photo src="projects/salban-orphanage/classroom.jpg" lang={lang} ratio="16 / 10" width={496} sizes="(min-width: 900px) 460px, 92vw" />
        <div class="way-copy">
          <h3>{t(lang, 'support.orphansTitle')}</h3>
          <p>{t(lang, 'support.orphansText')}</p>
          <a class="link-arrow" href={localizePath('/projects/salban-orphanage/', lang)}>
            {t(lang, 'support.orphansLink')}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>

      <div class="way">
        <h3 class="way-heading">{t(lang, 'support.projectsTitle')}</h3>
        <div class="proposed-grid">
          {
            proposedProjects.map((project) => (
              <ProjectCard project={project} lang={lang} ratio="4 / 3" sizes="(min-width: 1000px) 24vw, (min-width: 640px) 45vw, 92vw" showStatus={false} />
            ))
          }
        </div>
      </div>

      <div class="way partner">
        <Icon name="handshake" size={40} />
        <div>
          <h3>{t(lang, 'support.partnerTitle')}</h3>
          <p>{t(lang, 'support.partnerText')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="give" aria-labelledby="give-title">
    <div class="container give-grid">
      <div class="give-copy">
        <h2 id="give-title">{t(lang, 'support.giveTitle')}</h2>
        <p class="lead">{t(lang, 'support.giveText')}</p>
        {
          donation?.bank && (
            <div class="donation">
              <h3>{t(lang, 'support.bankTitle')}</h3>
              <dl>
                <dt>{t(lang, 'support.accountName')}</dt>
                <dd>{donation.bank.accountName}</dd>
                <dt>{t(lang, 'support.accountNumber')}</dt>
                <dd>{digits(donation.bank.accountNumber, lang)}</dd>
                <dt>{t(lang, 'support.bank')}</dt>
                <dd>
                  {donation.bank.bankName}, {donation.bank.branch}
                </dd>
                {donation.bank.routing && (
                  <>
                    <dt>{t(lang, 'support.routing')}</dt>
                    <dd>{donation.bank.routing}</dd>
                  </>
                )}
                {donation.bank.swift && (
                  <>
                    <dt>{t(lang, 'support.swift')}</dt>
                    <dd>{donation.bank.swift}</dd>
                  </>
                )}
              </dl>
            </div>
          )
        }
        {
          donation?.mobile && donation.mobile.length > 0 && (
            <div class="donation">
              <h3>{t(lang, 'support.mobileTitle')}</h3>
              <dl>
                {donation.mobile.map((m) => (
                  <>
                    <dt>{m.service}</dt>
                    <dd>{digits(m.number, lang)}</dd>
                  </>
                ))}
              </dl>
            </div>
          )
        }
      </div>
      <div class="give-contact">
        <ContactBlock lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container-narrow :global(.support-intro) {
    font-size: var(--step-1);
  }
  .ways-title {
    margin-bottom: var(--space-2xl);
  }
  .way + .way {
    margin-top: var(--space-3xl);
  }
  .way-children {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  .way-copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .way-copy p {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 55ch;
  }
  @media (min-width: 900px) {
    .way-children {
      grid-template-columns: 460px 1fr;
      gap: var(--space-3xl);
    }
  }
  .way-heading {
    margin-bottom: var(--space-xl);
  }
  .proposed-grid {
    display: grid;
    gap: var(--space-2xl) var(--space-l);
  }
  @media (min-width: 640px) {
    .proposed-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .proposed-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .partner {
    display: grid;
    gap: var(--space-l);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-md);
    background: var(--ivory);
    border: 1px solid var(--sand-deep);
  }
  .partner :global(.icon) {
    color: var(--terracotta);
  }
  .partner p {
    margin-top: var(--space-xs);
    color: var(--ink-soft);
    max-width: 70ch;
  }
  @media (min-width: 800px) {
    .partner {
      grid-template-columns: auto 1fr;
    }
  }
  .give-grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }
  .give-copy {
    display: grid;
    gap: var(--space-l);
  }
  .donation {
    padding: var(--space-l);
    border: 1px solid var(--sand-deep);
    border-radius: var(--r-md);
  }
  .donation dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem var(--space-m);
    margin-top: var(--space-s);
  }
  .donation dt {
    color: var(--ink-soft);
  }
  .donation dd {
    margin: 0;
    font-weight: 600;
  }
  .give-contact {
    padding: var(--space-xl);
    border-radius: var(--r-md);
    background: var(--sand);
  }
  @media (min-width: 900px) {
    .give-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3xl);
    }
  }
</style>
